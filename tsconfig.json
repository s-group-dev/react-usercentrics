{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "incremental": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "ESNext"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "paths": {
            "@s-group/react-usercentrics/augmented": ["./augmented.d.ts"]
        },
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node", "react", "react-dom", "vitest"]
    },
    "exclude": ["node_modules"],
    "include": ["**/*.mjs", "**/*.js", "**/*.ts", "**/*.tsx"]
}
